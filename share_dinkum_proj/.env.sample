SECRET_KEY=__REPLACE_ME__
DEBUG=True

DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
DB_USER=share_dinkum_app
DB_PASSWORD=SQLiteDoesNotUsePassword
DB_HOST=localhost


# Where the `media` folder (exports and attached documents) lives.
# Name the folder that holds it, not `media` itself. This can be your Documents folder, your home
# folder or a whole drive: only the `media` folder inside it is ever copied, emptied or restored.
# Blank = share_dinkum_proj/, so the media folder becomes share_dinkum_proj/media.
# Move your existing `media` folder there before changing it.
#   Absolute (Windows):  MEDIA_LOCATION=D:\share-dinkum-data   (gives D:\share-dinkum-data\media)
#   Absolute (macOS/Linux): MEDIA_LOCATION=/mnt/data/share-dinkum-data
#   Relative to share_dinkum_proj/:  MEDIA_LOCATION=my_data
MEDIA_LOCATION=


# Where backups go (uv run update.py, the dashboard, the notebook).
# Name the folder that holds the `share-dinkum-backups` folder, not that folder itself.
# It is recommended that you put this on a location which is covered by cloud backups!
# Each backup includes a copy of the media folder and the database.
# Blank = your home folder, so the backups are in ~/share-dinkum-backups.
#   Absolute (Windows):  BACKUP_LOCATION=D:\   (gives D:\share-dinkum-backups)
#   Absolute (macOS/Linux): BACKUP_LOCATION=/mnt/data   (gives /mnt/data/share-dinkum-backups)
#   Home folder:         BACKUP_LOCATION=~/Documents   (gives ~/Documents/share-dinkum-backups)
BACKUP_LOCATION=


# AI Features

# An AI to read a document no parser recognises: `uv run dev check_documents ... --ai`.
# Off unless set here AND --ai is given on the command. Only the document's text is sent, and each
# reply is kept in share_dinkum_proj/document_ai_cache/, so a document is sent once per model.
#   none               Off (the default).
#   openai_compatible  Any server with the OpenAI chat API. A local one, such as Ollama, keeps
#                      everything on this machine. A hosted one sends the text there, and the
#                      command warns you each time.
#   anthropic          Claude. Install it first: uv sync --inexact --extra anthropic
DOCUMENT_AI_PROVIDER=none

# The model to ask. Ollama: one you have pulled, eg qwen3:30b (ollama pull qwen3:30b).
# Blank with anthropic = claude-opus-5-5.
DOCUMENT_AI_MODEL=

# The server. Ollama: http://localhost:11434/v1   LM Studio: http://localhost:1234/v1
# Needed for openai_compatible; blank with anthropic = Anthropic's own API.
DOCUMENT_AI_BASE_URL=

# Blank for a local server. A hosted one needs its key. With anthropic, blank reads the
# ANTHROPIC_API_KEY environment variable.
DOCUMENT_AI_API_KEY=

# If using local LLM
# Ollama cuts off a document longer than its context window without saying so, and an annual tax
# statement can be. Raise the window in Ollama's own settings, not here: set the environment
# variable OLLAMA_CONTEXT_LENGTH=32768 (Windows: setx OLLAMA_CONTEXT_LENGTH 32768), or use the
# context length setting in the Ollama app, then restart Ollama.